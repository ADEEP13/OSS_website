# ==============================================================================
# Additions — package-manager and tooling conflicts
#
# CONTRIBUTING.md is explicit: "Do NOT run npm install or yarn install. Doing so
# generates conflicting lockfiles (package-lock.json or yarn.lock) and will
# cause automated CI workflows to fail."
#
# .gitignore cannot untrack a file that is already tracked, so these entries are
# a convenience, not the control. scripts/checks/check-forbidden-files.sh and
# scripts/checks/check-lockfiles.sh are what actually block them, because they
# look at what git has *tracked* rather than at what git is ignoring.
# ==============================================================================
package-lock.json
npm-shrinkwrap.json
.package-lock.json
yarn.lock
.yarn-integrity
bun.lockb
bun.lock
.pnp.cjs
.pnp.loader.mjs
.pnp.data.json
.npmrc
.yarnrc
.yarnrc.yml
.pnpmfile.cjs

# ==============================================================================
# Additions — secrets, one level deeper
#
# The original list covers .env* and PEM files. These cover the shapes a real
# leak actually takes.
# ==============================================================================
*.p12
*.pfx
*.jks
*.keystore
*.ppk
*.asc
id_rsa
id_rsa.pub
id_dsa
id_ecdsa
id_ed25519
id_ed25519.pub
secrets.json
secrets.yaml
secrets.yml
secrets.*.json
credentials.json
*.credentials
.serviceaccount
service-account*.json
gcp-*.json
.netrc

# ==============================================================================
