# ==============================================================================
.lighthouseci/
.playwright/
.auth/
.stfolder/
.history/
.claude/settings.local.json
.cursorrules.local
.aider*
.env*.local
*.local
.tool-versions
.python-version
.node_repl_history
.eslintcache
.prettiercache
.node-version
.nvmrc

